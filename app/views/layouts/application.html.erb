<!DOCTYPE html>
<html lang="vi">
  <head>
    <title><%= content_for(:title) || "Nhà Gô — Đồ secondhand tuyển chọn" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "Nhà Gô — shop áo quần secondhand (đồ si) tuyển chọn: đẹp, sạch, giá tốt. Nhắn Zalo để chốt đơn." %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nhà Gô">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag image_path("favicon.png"), type: "image/png" %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Sriracha&display=swap" rel="stylesheet">

    <%# Giao diện dùng CSS riêng của Nhà Gô (đã có reset riêng), không nạp Tailwind %>
    <%= stylesheet_link_tag "application", "nha_go", "cart", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/header" %>

    <% if flash.any? %>
      <div class="flash-wrap">
        <% flash.each do |type, message| %>
          <div class="flash flash-<%= type %>"><%= message %></div>
        <% end %>
      </div>
    <% end %>

    <main id="top">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>

    <div class="sticky-cta">
      <%= link_to "Nhắn Zalo chốt đơn", zalo_url, class: "btn btn-rust" %>
    </div>
  </body>
</html>
