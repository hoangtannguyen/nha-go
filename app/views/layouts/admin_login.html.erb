<!DOCTYPE html>
<html lang="vi">
  <head>
    <title>Đăng nhập quản trị — Nhà Gô</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= favicon_link_tag image_path("favicon.png"), type: "image/png" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Sriracha&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "nha_go", "cart", "admin", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="login-body">
    <main class="login-wrap">
      <%= yield %>
    </main>
  </body>
</html>
