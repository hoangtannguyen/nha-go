<div class="login-card">
  <div class="login-head">
    <%= image_tag "logo.webp", alt: "Nhà Gô", class: "login-logo" %>
    <h1>Đăng nhập quản trị</h1>
    <p>Khu vực dành riêng cho nhân sự của shop.</p>
  </div>

  <% if flash.now[:alert] || flash[:alert] %>
    <div class="form-errors"><p><%= flash[:alert] %></p></div>
  <% end %>

  <%= form_with url: admin_login_path, method: :post, class: "checkout-form" do |form| %>
    <div class="field">
      <%= form.label :email, "Email" %>
      <%= form.email_field :email, value: @email, autofocus: true, autocomplete: "username", required: true %>
    </div>

    <div class="field">
      <%= form.label :password, "Mật khẩu" %>
      <%= form.password_field :password, autocomplete: "current-password", required: true %>
    </div>

    <%= form.submit "Đăng nhập", class: "btn btn-rust" %>
  <% end %>

  <p class="login-back"><%= link_to "← Về trang bán hàng", root_path %></p>
</div>
