<div data-controller="reveal">
  <%# ===== HERO ===== %>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="badge">✦ Đồ si tuyển chọn từng món</span>
        <h1>Đồ secondhand <span class="hand">đẹp &amp; sạch</span><br>giá hợp túi tiền</h1>
        <p class="lead">Nhà Gô tuyển từng chiếc áo, từng cái quần từ những lô đồ si Nhật – Hàn - Châu Âu uy tín. Rửa sạch, lận phẳng, up lại như mới — bạn chỉ việc mặc.</p>

        <div class="hero-cta">
          <a class="btn btn-rust" href="#hang-moi">Xem hàng mới về</a>
          <a class="btn btn-ghost" href="#lien-he">Liên hệ shop</a>
        </div>

        <div class="hero-stats">
            <div><b>Hơn 10 năm</b><span>bán hàng tại nhà</span></div>
            <div><b>2.000+</b><span>món đã về nhà</span></div>
            <%# <div><b>5.0★</b><span>khách chấm shop</span></div> %>
            <div><b>1–3 ngày</b><span>giao toàn quốc</span></div>
        </div>
      </div>

      <div class="hero-img reveal" data-reveal-target="item">
        <%= site_image_tag :hero, alt: "Kệ đồ secondhand tại shop Nhà Gô" %>
        <div class="hero-tag">Hàng về mỗi tuần<small>Nhắn Zalo để giữ món</small></div>
      </div>
    </div>
  </section>

  <%# ===== FEATURES ===== %>
  <section class="features">
    <div class="wrap">
      <h2 class="sec-title reveal" data-reveal-target="item">Vì sao chọn <span class="hand">Nhà Gô</span>?</h2>
      <p class="sec-sub reveal" data-reveal-target="item">Mua đồ si mà yên tâm như mua đồ mới — đó là điều chúng tôi làm mỗi ngày.</p>

      <div class="feat-grid">
        <div class="feat reveal" data-reveal-target="item">
          <div class="ico">🔍</div>
          <h3>Tuyển chọn tay</h3>
          <p>Mỗi món đều được soi kỹ đường kim, chất vải, độ mới 9/10 trở lên mới được lên web.</p>
        </div>
        <div class="feat reveal" data-reveal-target="item">
          <div class="ico">🧼</div>
          <h3>Sạch &amp; khử khuẩn</h3>
          <p>Hàng về là giặt giũ, xử lý mùi, hấp là phẳng — nhận món nào thơm phức món đó.</p>
        </div>
        <div class="feat reveal" data-reveal-target="item">
          <div class="ico">💰</div>
          <h3>Giá thật, chốt nhanh</h3>
          <p>Giá niêm yết rõ ràng, không nói thách. Nhắn Zalo là chốt đơn, ship toàn quốc.</p>
        </div>
      </div>
    </div>
  </section>

  <%# ===== PRODUCTS ===== %>
  <section id="hang-moi" data-controller="filter">
    <div class="wrap">
      <h2 class="sec-title reveal" data-reveal-target="item">Hàng mới về <span class="hand">mỗi tuần</span></h2>
      <p class="sec-sub reveal" data-reveal-target="item">Số lượng có 1, ai nhanh tay người đó mặc. Bấm "Nhắn mua" là nhắn Zalo trực tiếp món đó.</p>

      <div class="chips reveal" data-reveal-target="item">
        <button class="chip active" data-cat="all" data-filter-target="chip" data-action="click->filter#filter">Tất cả</button>
        <% @categories.each do |category| %>
          <button class="chip" data-cat="<%= category.slug %>" data-filter-target="chip" data-action="click->filter#filter"><%= category.name %></button>
        <% end %>
      </div>

      <div class="grid">
        <%= render partial: "shops/product", collection: @products, as: :product %>
      </div>

      <p class="empty" data-filter-target="empty">Hụ rồi, món này vừa được lấy hết — ghé lại sau nha! 👀</p>

      <div class="see-all reveal" data-reveal-target="item">
        <%= link_to products_path, class: "btn btn-rust" do %>
          Xem tất cả <%= @total_count %> món →
        <% end %>
        <span class="see-all-note">Lọc theo danh mục, sắp xếp theo giá ở trang đầy đủ</span>
      </div>
    </div>
  </section>

  <%# ===== ABOUT ===== %>
  <section class="about" id="ve-nha-go">
    <div class="wrap about-grid">
      <div class="imgbox reveal" data-reveal-target="item">
        <%= site_image_tag :about, alt: "Tủ đồ secondhand được tuyển chọn tại Nhà Gô" %>
      </div>
      <div class="reveal" data-reveal-target="item">
        <h2 class="sec-title"><%= site_setting.text(:about_title) %> <span class="hand"><%= site_setting.text(:about_title_highlight) %></span></h2>
        <% site_setting.about_paragraphs.each do |paragraph| %>
          <p><%= paragraph %></p>
        <% end %>
        <p class="quote"><%= site_setting.text(:about_quote) %></p>
      </div>
    </div>
  </section>

  <%# ===== CONTACT ===== %>
  <section class="contact" id="lien-he">
    <div class="wrap">
      <h2 class="sec-title reveal" data-reveal-target="item">Nhắn shop <span class="hand">luôn nha</span></h2>
      <p class="sec-sub reveal" data-reveal-target="item">Món nào ưng, nhắn ngay để giữ đồ — hàng si nhanh tay là hết đó.</p>

      <div class="contact-grid">
        <div class="reveal" data-reveal-target="item">
          <div class="c-line">
            <div class="ico">📱</div>
            <div><b>Hotline / Zalo</b><span><%= ApplicationHelper::SHOP_PHONE_DISPLAY %> (nhắn bất cứ lúc nào)</span></div>
          </div>
          <div class="c-line">
            <div class="ico">💬</div>
            <div><b>Facebook</b><span>fb.com/nhago.thrift — update hàng mỗi tối</span></div>
          </div>
          <div class="c-line">
            <div class="ico">📍</div>
            <div><b>Địa chỉ shop</b><span>97 Ngô Đức Kế, TP. Huế</span></div>
          </div>
          <div class="c-line">
            <div class="ico">🕒</div>
            <div><b>Giờ mở cửa</b><span>8:00 – 21:00, tất cả các ngày trong tuần</span></div>
          </div>
        </div>

        <div class="contact-cta reveal" data-reveal-target="item">
          <h3>Chốt đơn qua Zalo</h3>
          <p>Gửi tên món + size, shop giữ đồ cho bạn 24h và ship toàn quốc COD.</p>

          <%= link_to "Nhắn Zalo: #{ApplicationHelper::SHOP_PHONE_DISPLAY}", zalo_url, class: "btn btn-rust" %>
          <%= link_to "Xem hàng trên Facebook", ApplicationHelper::SHOP_FACEBOOK, class: "btn btn-olive", target: "_blank", rel: "noopener" %>
          <%= link_to "Gọi hotline", "tel:#{ApplicationHelper::SHOP_PHONE}", class: "btn btn-ghost" %>

          <p class="note">Freeship đơn từ 200.000đ nội thành TP. Huế</p>
        </div>
      </div>
    </div>
  </section>
</div>
