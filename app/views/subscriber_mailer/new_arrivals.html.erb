<p style="font-size:17px;font-weight:bold;margin:0 0 12px">
  Hàng mới về rồi <%= @subscriber.display_name %> ơi!
</p>

<p style="font-size:14px;line-height:1.7;color:#8a7f6d;margin:0 0 20px">
  Shop vừa lên <%= @products.size %> món. Mỗi món chỉ có một chiếc, ưng là nhắn shop giữ liền nha.
</p>

<% @products.each do |product| %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
         style="margin-bottom:14px;background:#f7f1e3;border-radius:12px">
    <tr>
      <td width="96" style="padding:12px">
        <% if product.main_photo %>
          <%= image_tag url_for(product.main_photo), width: 84, height: 84,
                        alt: product.name, style: "border-radius:10px;display:block;object-fit:cover" %>
        <% elsif product.image.present? %>
          <%= image_tag asset_url(product.image), width: 84, height: 84,
                        alt: product.name, style: "border-radius:10px;display:block;object-fit:cover" %>
        <% end %>
      </td>
      <td style="padding:12px 14px 12px 0;vertical-align:top">
        <div style="font-size:11px;color:#8a7f6d;text-transform:uppercase;letter-spacing:.5px">
          <%= product.category_name %>
        </div>
        <div style="font-size:15px;font-weight:bold;margin:3px 0">
          <a href="<%= product_url(product) %>" style="color:#2e2a24;text-decoration:none"><%= product.name %></a>
        </div>
        <div style="font-size:12px;color:#8a7f6d"><%= product.size_summary %></div>
        <div style="font-size:16px;font-weight:bold;color:#3f4d28;margin-top:6px">
          <%= price_vnd(product.price) %>
        </div>
      </td>
    </tr>
  </table>
<% end %>

<table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:18px">
  <tr>
    <td style="background:#c1502e;border-radius:999px">
      <a href="<%= products_url %>"
         style="display:inline-block;padding:12px 26px;color:#ffffff;font-size:14px;font-weight:bold;text-decoration:none">
        Xem tất cả hàng đang có
      </a>
    </td>
  </tr>
</table>
